+import pytest
+
+from jev_ultrafast import browser
+
+
+def test_background_renderer_is_awake_before_metrics(monkeypatch):
+    calls = []
+    monkeypatch.setattr(browser, 'ensure_daemon', lambda **kwargs: None)
+    def cdp(method, **kwargs):
+        calls.append((method, kwargs))
+        return {
+            'Target.createTarget': {'targetId': 'owned'},
+            'Target.attachToTarget': {'sessionId': 'session'},
+            'Runtime.evaluate': {'result': {'value': 'complete'}},
+        }.get(method, {})
+    monkeypatch.setattr(browser, 'cdp', cdp)
+    instance = browser.Browser('https://example.com')
+    assert calls[0][1]['background'] is True
+    names = [method for method, _ in calls]
+    assert names.index('Emulation.setFocusEmulationEnabled') < names.index('Emulation.setDeviceMetricsOverride')
+    instance.close()
+    assert calls[-1] == ('Target.closeTarget', {'targetId': 'owned'})
+
+
+def test_failed_constructor_closes_only_its_owned_tab(monkeypatch):
+    closed = []
+    monkeypatch.setattr(browser, 'ensure_daemon', lambda **kwargs: None)
+    def cdp(method, **kwargs):
+        if method == 'Emulation.setDeviceMetricsOverride':
+            raise TimeoutError('renderer timed out')
+        if method == 'Target.closeTarget':
+            closed.append(kwargs['targetId'])
+        return {'Target.createTarget': {'targetId': 'owned'},
+                'Target.attachToTarget': {'sessionId': 'session'}}.get(method, {})
+    monkeypatch.setattr(browser, 'cdp', cdp)
+    with pytest.raises(TimeoutError):
+        browser.Browser('https://example.com')
+    assert closed == ['owned']
