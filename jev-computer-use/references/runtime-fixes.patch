+        if not ready or top_window_at(point) != screen.window_id:
+            return False
+        err, element = AS.AXUIElementCopyElementAtPosition(AS.AXUIElementCreateSystemWide(), *point, None)
+        if err or element is None or AS.AXUIElementGetPid(element, None) != (0, screen.pid):
+            return False
+        old_mouse = mouse_location()
+        click_at(point)
+        if all(abs(a - b) < 2 for a, b in zip(mouse_location(), point, strict=True)):
+            Quartz.CGWarpMouseCursorPosition(old_mouse)
+        return True
+
+
+def key_window(screen, key: str, command: bool = False) -> bool:
+    with target_focus(screen) as ready:
+        if not ready:
+            return False
+        x, y, w, h = screen.window
+        if top_window_at((x + w / 2, y + h / 2)) != screen.window_id:
+            return False
+        press(key, command)
+        return True
+
+
+def scroll_window(screen, lines: int) -> bool:
+    with target_focus(screen) as ready:
+        if not ready:
+            return False
+        x, y, w, h = screen.window
+        point = (x + w / 2, y + h / 2)
+        if top_window_at(point) != screen.window_id:
+            return False
+        old_mouse = mouse_location()
+        _post(Quartz.CGEventCreateMouseEvent(None, Quartz.kCGEventMouseMoved, point, Quartz.kCGMouseButtonLeft))
+        _post(Quartz.CGEventCreateScrollWheelEvent(None, Quartz.kCGScrollEventUnitLine, 1, lines))
+        if all(abs(a - b) < 2 for a, b in zip(mouse_location(), point, strict=True)):
+            Quartz.CGWarpMouseCursorPosition(old_mouse)
+        return True
+
+
+def type_window(screen, text: str) -> bool:
+    with target_focus(screen) as ready:
+        if not ready:
+            return False
+        field = focused_field()
+        if field != screen.field or not field.is_text:
+            return False
+        press("a", command=True)
+        type_text(text)
+        return True
+
+
+def actionable_window_elements(pid: int, bounds: Frame) -> tuple[list[AxNode], list[AxNode], bool]:
+    """Walk the selected native window/sheet first, before a browser's large page tree."""
+    app = AS.AXUIElementCreateApplication(pid)
+    AS.AXUIElementSetMessagingTimeout(app, AX_MESSAGE_TIMEOUT)
+    queue = deque((w, 0) for w in (_ax_attr(app, "AXWindows") or []))
+    candidate = None
+    visited = set()
+    deadline = time.monotonic() + 2
+    while queue and time.monotonic() < deadline:
+        node, depth = queue.popleft()
+        identity = node_identity(node)
+        if identity in visited:
+            continue
+        visited.add(identity)
+        role, _, frame = _ax_attrs(node)
+        if frame and all(abs(a - b) < 2 for a, b in zip(frame, bounds, strict=True)):
+            if role in {"AXSheet", "AXDialog", "AXWindow"}:
+                candidate = node
+                break
+            candidate = node
+        if depth < 4:
+            queue.extend((child, depth + 1) for child in _ax_children(node))
+    if candidate is None:
+        return [], [], False
+    x, y, width, height = bounds
+
+    def local_attrs(node):
+        role, label, frame = _ax_attrs(node)
+        if frame:
+            frame = (frame[0] - x, frame[1] - y, frame[2], frame[3])
+        return AxAttrs(role, label, frame)
+
+    return walk_actionable(candidate, _ax_children, local_attrs, _ax_actions, width, height)
