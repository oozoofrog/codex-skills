+import pytest
+from PIL import Image
+
+from typesafe_computer_use import actions, macos, perception
+from typesafe_computer_use.models import Item, Screen, TargetUnavailable
+
+
+def target():
+    return Screen(
+        Image.new("RGB", (800, 400), "white"),
+        2,
+        "Target",
+        None,
+        None,
+        pid=42,
+        window=(100, 200, 400, 200),
+        window_id=77,
+        window_title="Fixture",
+        origin=(100, 200),
+        actual_frontmost_app="Other app",
+    )
+
+
+def test_target_coordinates_include_window_origin():
+    assert target().to_points(Item(0, "button", 1, 200, 100, 240, 140)) == (210, 260)
+
+
+def test_capture_uses_target_window_not_current_display(monkeypatch):
+    monkeypatch.setattr(macos, "app_pid", lambda name: 42)
+    monkeypatch.setattr(macos, "select_window", lambda *args: object())
+    monkeypatch.setattr(macos, "window_record", lambda w: (77, "Fixture", (100, 200, 400, 200)))
+    monkeypatch.setattr(macos, "window_screenshot", lambda ident: target().image)
+    monkeypatch.setattr(macos, "focused_field", lambda pid: None)
+    monkeypatch.setattr(macos, "frontmost_app", lambda: "Other app")
+    monkeypatch.setattr(macos, "screenshot", lambda: pytest.fail("must not capture another app"))
+    screen = perception.capture(target_app="Target")
+    assert screen.window_id == 77 and screen.app == "Target" and screen.actual_frontmost_app == "Other app"
+    assert screen.origin == (100, 200) and screen.scale == 2
+
+
+def test_missing_target_never_falls_back_to_foreground(monkeypatch):
+    def unavailable(name):
+        raise TargetUnavailable("missing app")
+
+    monkeypatch.setattr(macos, "app_pid", unavailable)
+    monkeypatch.setattr(macos, "screenshot", lambda: pytest.fail("foreground fallback"))
+    with pytest.raises(TargetUnavailable):
+        perception.capture(target_app="Missing")
+
+
+def test_background_click_does_not_use_global_mouse(monkeypatch):
+    screen = target()
+    dispatched = []
+    monkeypatch.setattr(macos, "window_is_current", lambda s: True)
+    monkeypatch.setattr(macos, "window_screenshot", lambda ident: screen.image)
+    monkeypatch.setattr(macos, "click_at", lambda point: pytest.fail("global input"))
+    monkeypatch.setattr(macos, "click_window", lambda s, point: dispatched.append((s.pid, s.window_id, point)) or True)
+    result = actions.click_item(Item(0, "button", 1, 200, 100, 240, 140), screen)
+    assert "temporary focus" in result
+    assert dispatched == [(42, 77, (210, 260))]
+
+
+def test_changed_target_pixels_refuse_mutation(monkeypatch):
+    monkeypatch.setattr(macos, "window_is_current", lambda s: True)
+    monkeypatch.setattr(macos, "window_screenshot", lambda ident: Image.new("RGB", (800, 400), "black"))
+    monkeypatch.setattr(macos, "click_window", lambda *args: pytest.fail("stale mutation"))
