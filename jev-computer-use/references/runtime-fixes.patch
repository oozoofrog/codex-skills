+from PIL import Image
+
+from typesafe_computer_use import perception
+from typesafe_computer_use.models import Screen
+
+
+def test_full_display_includes_dialog_outside_helper_window(monkeypatch):
+    screen = Screen(Image.new("RGB", (2048, 1152)), 1, "Google Chrome", None, None, window=(0, 0, 2048, 25))
+    monkeypatch.setenv("CLICKER_FULL_SCREEN", "1")
+    assert perception.ocr_region(screen) == (0, 0, 2048, 1152)
+    monkeypatch.setenv("CLICKER_FULL_SCREEN", "0")
+    assert perception.ocr_region(screen)[3] < 100
+
+
+def test_ocr_passes_korean_and_english_to_vision(monkeypatch):
+    captured = {}
+
+    class OCR:
+        def __init__(self, image, **kwargs):
+            captured.update(kwargs)
+
+        def recognize(self, px):
+            return [("허용", 1.0, (10, 20, 30, 40))]
+
+    monkeypatch.delenv("CLICKER_OCR_LANGUAGES", raising=False)
+    monkeypatch.setattr(perception.ocrmac, "OCR", OCR)
+    assert perception.ocr_crop(Image.new("RGB", (100, 100)), (0, 0, 100, 100))[0][0] == "허용"
+    assert captured["language_preference"] == ["ko-KR", "en-US"]
+
+
+def test_retina_ocr_restores_click_coordinates(monkeypatch):
+    class OCR:
+        def __init__(self, image, **kwargs):
+            assert image.size == (1920, 1080)
+
+        def recognize(self, px):
+            return [("허용", 0.5, (1120, 600, 1160, 625))]
+
+    monkeypatch.setattr(perception.ocrmac, "OCR", OCR)
+    result = perception.ocr_crop(Image.new("RGB", (3840, 2160)), (0, 0, 3840, 2160))
+    assert result[0][2] == (2240, 1200, 2320, 1250)
